					width = medium
				)
				Cost_Per_Cut
				(
					type = picklist
					displayname = "Cost Per Cut "
					maxchar = 100
					values = {"#7","#5","#2.5"}
					width = medium
				)
				CTP
				(
					type = picklist
					maxchar = 100
					values = {"Kord","MO","Sord","SM","ADAZ"}
					width = medium
				)
				Currency
				(
					type = NGN
					format = commadotwestern
					width = medium
				)
				Cost_Per_Color
				(
					type = picklist
					displayname = "Cost Per Color"
					maxchar = 100
					values = {"#1,750","#2,000","#5,000"}
					width = medium
				)
				Currency1
				(
					displayname = "Currency"
					type = NGN
					format = commadotwestern
					width = medium
				)
				Print
				(
					type = picklist
					maxchar = 100
					values = {"Kord","MO","Sord","SM","DI Paper Print","DI Card Print","Screenprinting","ADAZ"}
					width = medium
				)
				Cost_Per_Color1
				(
					type = picklist
					displayname = "Cost Per Color"
					maxchar = 100
					values = {"#2,000","#4,000","#6,000","#7,500","#350","#500","#60"}
					width = medium
				)
				Lamination_Type
				(
					type = picklist
					displayname = "Lamination Type"
					maxchar = 100
					values = {"Gloss","Matte"}
					width = medium
				)
				Size
				(
					type = picklist
					displayname = "Size "
					maxchar = 100
					values = {"16*18","13.5*15.5","10*15.5","12*24","12*12","14*14","12*22","12*18","12*9","6*9","10*10","11*14","18*24","18*81","24*36"}
					width = medium
				)
				Gloss_Cost
				(
					type = picklist
					displayname = "Gloss Cost "
					maxchar = 100
					values = {"#40","#18","#15","#14","#25","#12","#10","#8","#42","#50"}
					width = medium
				)
				Matte_Cost
				(
					type = picklist
					displayname = "Matte Cost "
					maxchar = 100
					values = {"#50","#24","#18","#17","#30","#15","#22","#45","#48","#55"}
					width = medium
				)
				Diecut_Size
				(
					type = picklist
					displayname = "Diecut Size "
					maxchar = 100
					values = {"16*18","13.5*15.5","10*20.5","10*15.5","12*24","12*12","14*14","12*22","12*18","12*9","6*9","10*10","11*14","18*241","18*81","24*36"}
					width = medium
				)
				Cost_Per_Diecut
				(
					type = picklist
					displayname = "Cost Per Diecut"
					maxchar = 100
					values = {"#15","#6","#4"}
					width = medium
				)
				Item_Finished
				(
					type = picklist
					displayname = "Item Finished"
					maxchar = 100
					values = {"Choice 1","Choice 2","Choice 3"}
					width = medium
				)
				twisted_handles
				(
    				type = text
					displayname = "twisted handles "
					initial value = "65"
					width = medium
				)
				Operation_Name
				(
    				type = text
					displayname = "Operation Name "
					width = medium
				)
				Quantity_Wasted
				(
					type = number
					displayname = "Quantity Wasted "
					width = medium
				)
				Role
				(
					type = picklist	
					values  = Staff.ID
    				displayformat = [Role]
					sortorder = ascending
					width = medium
				)
				Estimated_Time_in_mins
				(
					type = number
					displayname = "Estimated Time (in mins) "
					width = medium
				)
				Cost_Per_Finish
				(
					type = picklist
					displayname = "Cost Per Finish "
					maxchar = 100
					values = {"#18","#12","#5","#4"}
					width = medium
				)
				Labour_Cost
				(
					type = number
					displayname = "Labour Cost"
					width = medium
				)
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Subtotal
			(
				type = NGN
				format = commadotwestern
	 			row = 4
	 			column = 1   
				width = medium
			)
			GrandTotal
			(
				type = NGN
				format = commadotwestern
	 			row = 4
	 			column = 1   
				width = medium
			)
			Labour_Cost
			(
				displayname = "Labour Cost"
				type = NGN
				format = commadotwestern
	 			row = 4
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Staff
		{
			success message = "Staff Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Staff_ID
			(
    			type = text
				displayname = "Staff ID "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Role
			(
				type = picklist
				maxchar = 100
				values = {"Administrator","Inventory Manager","Production Staff","Finishing supervisor","Customer care rep","Sales Representative"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Orders
		{
			displayName = "All Orders"
			show all rows from Order_Form    
			(
				Customer as "Customer "
				Sales_Order_ID as "Sales Order ID "
				Created_on_date_time as "Created  on (date & time )"
				Expected_Shipment_Date as "Expected Shipment Date"
				Order_Completion_Date as "Order Completion Date"
				Item_Availability as "Item Availability"
				Items.Order_Form as "Items"
				Subtotal as "Subtotal "
				Total
			)
		}
		default list All_Inventories
		{
			displayName = "All Inventories"
			show all rows from Inventory    
			(
				SKU
				Received_Date as "Received Date"
				Item_Name as "Item Name"
				item_Type as "item Type"
				Category
				Quantity_In_Stock as "Quantity In Stock"
				Average_Price as "Average Price "
				Price
			)
		}
		default list Product_BOM_Report
		{
			displayName = "Product BOM Report"
			show all rows from Product_BOM    
			(
				Item_Name as "Item Name "
				SKU
				Product_Type as "Product Type"
				Product_Category as "Product Category"
				Opening_Stock as "Opening Stock"
				Bill_Of_Materials.Material_Name as "Bill Of Materials"
				Operations.Operation_Stage as "Operations"
			)
		}
		default list All_Staffs
		{
			displayName = "All Staffs"
			show all rows from Staff    
			(
				Staff_ID as "Staff ID "
				Name 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Role
				Address 
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
		}
		default list Product_Order_Report
		{
			displayName = "Product Order Report"
			show all rows from Product_Order    
			(
				SKU
				Product_Type as "Product Type"
				Quantity
				Product_Name as "Product Name "
				Product_Category as "Product Category"
				priority
				Order_Type as "Order Type"
				Subtotal
				Labour_Cost as "Labour Cost"
				GrandTotal
			)
		}
		default list All_Operations
		{
			displayName = "All Operations"
			show all rows from Operations    
			(
				Operation_ID as "Operation ID"
				Operation_Stage as "Operation Stage"
				Product_Order_ID as "Product  Order ID"
				Role
				Assigned_Staff as "Assigned Staff"
				Estimated_Time_in_mins as "Estimated Time (in mins) "
				Details
				Start_Time as "Start Time"
				End_Time as "End Time"
				Status
			)
		}
	}


	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


