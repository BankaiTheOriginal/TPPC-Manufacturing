model Location {
  id String @default(cuid()) @id
  name String
  addressLine String
  country String @default("NIGERIA")
  state State

  users User[]
  workerActivities FactoryWorkerActivity[]
}

model Machine {
  id             String         @id @default(cuid())
  name           String
  operationStage OperationStage
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([name, operationStage])
  @@index([operationStage])
}

model Vendor {
  id             String         @id @default(cuid())
  name           String
  operationStage OperationStage
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([name, operationStage])
  @@index([operationStage])
}

model FactoryWorkerActivity {
  id               String   @id @default(cuid())
  productOrderId   String?
  locationId       String
  supervisorId     String                     // FK to User
  workerNames      String   @db.Text          // JSON array of worker names
  workDate         DateTime
  quantityAllocated Int
  quantityFinished  Int      @default(0)
  quantityWasted    Int      @default(0)
  typeOfFinishing   String?
  costPerFinish     Decimal? @db.Decimal(15, 2)
  notes             String?  @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  productOrder ProductOrder? @relation(fields: [productOrderId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id])
  supervisor   User          @relation(fields: [supervisorId], references: [id])

  @@index([productOrderId])
  @@index([locationId])
  @@index([supervisorId])
  @@index([workDate])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String                         // TASK_ASSIGNED, PRODUCTION_COMPLETE, DRAFT_APPROVAL, etc.
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  metadata  String?  @db.Text             // optional JSON payload (e.g. orderId, taskId)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

// ============================================================================
// TASK GATING & APP SETTINGS
// ============================================================================

/// Global prerequisite configuration for task gating.
/// Each row says "before stage X can start, stage Y must be at least partially complete."
/// If no row exists for a stage, it has no prerequisite (nil — open from day one).
model TaskPrerequisite {
  id                String          @id @default(cuid())
  stage             OperationStage  @unique      // the stage that is gated
  requiredStage     OperationStage               // must be partially/fully complete first
  unlockThreshold   String          @default("partial_any")  // partial_any | full | percentage
  thresholdPercent  Int?                                      // only used when unlockThreshold = percentage
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// Per-order prerequisite overrides. Only created when a PM overrides the global default.
model TaskPrerequisiteOverride {
  id                String          @id @default(cuid())
  productOrderId    String
  stage             OperationStage
  requiredStage     OperationStage?             // null = no prerequisite (override to nil)
  unlockThreshold   String          @default("partial_any")
  thresholdPercent  Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productOrder ProductOrder @relation(fields: [productOrderId], references: [id], onDelete: Cascade)

  @@unique([productOrderId, stage])
  @@index([productOrderId])
}

/// Key-value application settings (logo path, feature flags, etc.)
model AppSetting {
  key       String   @id          // e.g. "company_logo_url", "company_name"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}